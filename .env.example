# ============================================================
# SCX Backend 环境变量配置模板（微服务版）
# ============================================================
# 用法：复制本文件为 .env，填入你的真实配置
#   cp .env.example .env
#
# 加载机制（spring.config.import: optional:file:.env[.properties]）：
#   - IDEA 运行/调试   → 自动读 .env
#   - ./gradlew bootRun → 自动读 .env
#   - java -jar        → 自动读 .env（同目录）
#   - Docker / K8s     → 用 -e / Secret 注入（生产不用 .env 文件）
#
# 优先级：真实 OS 环境变量 > .env 文件 > application.yml 默认值
# ============================================================

# -------------------- 通用配置 --------------------
SPRING_PROFILES_ACTIVE=dev
NODE_ENV=development

# -------------------- 服务端口 --------------------
# 网关为唯一对外入口（8080），其余服务端口供内部通信/本地调试
GATEWAY_PORT=8080
IDENTITY_PORT=3001
RBAC_PORT=3002
NOTIFICATION_PORT=3003
FILE_PORT=3004

# -------------------- 服务间地址（网关路由用）--------------------
# 生产/容器环境用服务名；本地联调用 localhost
IDENTITY_BASE_URL=http://localhost:3001
RBAC_BASE_URL=http://localhost:3002
NOTIFICATION_BASE_URL=http://localhost:3003
FILE_BASE_URL=http://localhost:3004

# -------------------- 数据库 (PostgreSQL) --------------------
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=scx
DB_PASSWORD=your_secure_password_here
DB_DATABASE=scx-backend

# -------------------- Redis --------------------
REDIS_HOST=localhost
REDIS_PORT=6388
REDIS_PASSWORD=

# -------------------- MinIO 对象存储（file-service 用）--------------------
# endpoint：服务连接地址（本地联调 localhost，容器环境为服务名 http://minio:9000）
# public-endpoint：浏览器可达地址（用于生成预签名 URL），为空时复用 endpoint
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=scx_minio
MINIO_SECRET_KEY=your_minio_password_here
MINIO_BUCKET=scx-files
# 预签名 URL 有效期（秒，默认 1 小时）
MINIO_PRESIGN_EXPIRY=3600

# -------------------- 上传大小限制（file-service 用）--------------------
FILE_MAX_FILE_SIZE=50MB
FILE_MAX_REQUEST_SIZE=100MB

# -------------------- JWT（HMAC-SHA256 令牌密钥）--------------------
# gateway 与 identity 必须使用同一密钥，否则网关验签失败
JWT_SECRET=please_change_to_a_strong_random_secret

# -------------------- 邮件配置（QQ 邮箱示例）--------------------
# QQ 邮箱用 465 + SSL：MAIL_SSL=true, MAIL_STARTTLS=false
# Gmail 等用 587 + STARTTLS：MAIL_SSL=false, MAIL_STARTTLS=true
MAIL_ENABLED=true
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_SSL=true
MAIL_STARTTLS=false
MAIL_USER=your_qq@qq.com
MAIL_PASSWORD=your_smtp_auth_code
MAIL_TIMEOUT_MS=30000
# QQ 邮箱授权码获取：设置 → 账户 → POP3/SMTP 服务 → 开启 → 生成授权码（非登录密码）

# -------------------- 应用名（邮件模板变量）--------------------
APP_NAME=SCX Service

# -------------------- Swagger 文档 --------------------
SWAGGER_TITLE=SCX Backend API
SWAGGER_DESCRIPTION=SCX Backend API Documentation
SWAGGER_VERSION=1.0

# -------------------- 超级管理员初始密码 --------------------
# 首次启动 identity 的 SeedService 创建超管用户用，生产环境必须覆盖
ADMIN_INITIAL_PASSWORD=changeme123
